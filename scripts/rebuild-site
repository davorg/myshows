#!/usr/bin/env python3
"""Rebuild the static dashboard from saved public inputs without network access."""
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
sys.path.insert(0, str(ROOT))
from myshows.__main__ import main

sys.exit(main(["rebuild-site", *sys.argv[1:]]))
